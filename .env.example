# Placeholders only. Copy to .env and fill locally. Never commit .env.
CITY=chennai

# Zetaris (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# ...or point at a file instead of pasting the value (preferred):
# ZETARIS_API_KEY_FILE=~/.secrets/nexus-zetaris.key

# Meterless Nightshift (primary AI provider). NVIDIA key lives only in Nightshift.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# METERLESS_RUNTIME_TOKEN_FILE=%LOCALAPPDATA%/ai.meterless.runtime/proxy-token   (written by Nightshift itself)
LANE_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
LANE_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
LANE_REASON=nvidia/nemotron-3-ultra-550b-a55b
LANE_AUDIO=
LANE_GUARD=
LANE_TINY=
LANE_EMBED=nvidia/nemotron-3.5-embed-1b

# Supabase (system of record)
SUPABASE_URL=https://ukrujnsjucwvytnokbtw.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SERVICE_ROLE_KEY_FILE=~/.secrets/nexus-service-role.key

# Web app (also set in Vercel; public values only)
NEXT_PUBLIC_SUPABASE_URL=https://ukrujnsjucwvytnokbtw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MAPTILER_KEY=

# S3 data bucket
S3_BUCKET=nexus-chennai-data
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret

# Runtime
SAMPLE_MODE=false
MAX_AGENT_ROUNDS=3
RUN_DEADLINE_SECONDS=300
LOG_LEVEL=INFO
PORT=8000

# Build-time only (demo narration, synthetic audio); never used by the running product
ELEVENLABS_API_KEY=your-elevenlabs-key

# Meterless engines (engg/docs/ENGINES.md)
ENGINES_BACKEND=sample                    # sample (in-process) | sidecar (engines-ts, npm run sidecar)
ENGINES_SIDECAR_URL=http://127.0.0.1:8790
# Set to `supabase` for live runs so the console's memory and graph pages fill (writes engine state to the 0005
# tables with the service role). Leave empty for tests and sample mode, which have no Supabase credentials.
ENGINES_PERSIST=
ENGINES_HMEM_STORE=nexus

# Where agent results go (WS2-22): supabase | local | memory. Empty = automatic: Supabase when configured,
# else JSON files under data/local/ in live mode and memory in sample mode. The worker always needs Supabase.
NEXUS_STORE=
# NEXUS_LOCAL_DIR=data/local
